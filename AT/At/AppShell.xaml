<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:AlertaTemprana"
       x:Class="AlertaTemprana.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"

       Shell.TabBarBackgroundColor="{StaticResource CardBackground}"
       Shell.TabBarForegroundColor="{StaticResource AccentBlue}"
       Shell.TabBarTitleColor="{StaticResource AccentBlue}"
       Shell.TabBarUnselectedColor="{StaticResource InactiveGray}">

    <TabBar>

        <ShellContent
            Title="Inicio"
            Icon="casa.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="inicio" />

        <ShellContent
            Title="Historial"
            Icon="historial.png"
            ContentTemplate="{DataTemplate local:Historialpage}"
            Route="historial" />

    </TabBar>

</Shell>